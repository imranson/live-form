# --- Option A (default): use your local Ollama app as a gateway to cloud models ---
# Run `ollama signin` once, then any model ending in ":cloud" / "-cloud" runs on Ollama's cloud.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=kimi-k2.6:cloud
# Tried if the primary model errors or returns unusable output
OLLAMA_FALLBACK_MODEL=gemma4:31b-cloud

# --- Option B: call ollama.com directly (no local Ollama needed) ---
# Create a key at https://ollama.com/settings/keys. When set, OLLAMA_HOST is ignored
# and the ":cloud" / "-cloud" suffix is stripped from model names automatically.
# OLLAMA_API_KEY=

PORT=8787

# --- Optional ---
# "offline" skips the AI entirely and uses the built-in question bank (handy for demos without internet)
# AI_MODE=ollama
# Questions per session (5–12)
# QUESTION_COUNT=8
# Per-request model timeout
# OLLAMA_TIMEOUT_MS=45000
# Anonymous sessions are deleted after this much inactivity
# SESSION_TTL_MINUTES=60
